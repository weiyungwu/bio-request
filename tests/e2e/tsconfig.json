{
  "extends": "@tsconfig/node24/tsconfig.json",
  "include": ["./**/*"],
  "compilerOptions": {
    // Same as tsconfig.node.json: Playwright transpiles, so check only (vue-tsc --build).
    "module": "preserve",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    // lib replaces, not extends, the base list: copied from @tsconfig/node24 (keep in sync
    // when upgrading it) plus DOM for page.evaluate callbacks. DOM types then type-check
    // anywhere in E2E files, not only inside page.evaluate; accepted trade-off.
    "lib": [
      "es2024",
      "ESNext.Array",
      "ESNext.Collection",
      "ESNext.Error",
      "ESNext.Iterator",
      "ESNext.Promise",
      "DOM"
    ],
    "types": ["node"],
    "noEmit": true,
    "tsBuildInfoFile": "../../node_modules/.tmp/tsconfig.e2e.tsbuildinfo"
  }
}
