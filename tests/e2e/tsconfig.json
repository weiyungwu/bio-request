{
  "extends": "@tsconfig/node24/tsconfig.json",
  "include": ["./**/*"],
  "compilerOptions": {
    // Same as tsconfig.node.json: Playwright transpiles, so check only (vue-tsc --build).
    "module": "preserve",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    // DOM: page.evaluate callbacks run in the browser.
    "lib": [
      "es2024",
      "ESNext.Array",
      "ESNext.Collection",
      "ESNext.Error",
      "ESNext.Iterator",
      "ESNext.Promise",
      "DOM"
    ],
    "types": ["node"],
    "noEmit": true,
    "tsBuildInfoFile": "../../node_modules/.tmp/tsconfig.e2e.tsbuildinfo"
  }
}
